---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { MapPin, ArrowRight } from "@lucide/astro";

const recentPosts = (await getCollection("blog", ({ data }) => {
    return data.draft !== true;
}))
.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
.slice(0, 3);
---

<section class="home-work-snippet">
    <div class="container">
        <div class="section-intro">
            <h2>Recent Projects</h2>
            <p>Real results for homeowners across the York Region.</p>
        </div>

        <div class="snippet-grid">
            {recentPosts.map((post) => (
                <article class="card-wrapper">
                    <a href={`/blog/${post.slug}`} class="mini-card">
                        <div class="img-container">
                            {/* FIX: Ensure your schema allows the Image component to resolve the URL */}
                            <Image 
                                src={post.data.images[1].url} 
                                alt={post.data.images[1].alt}
                                width={600} 
                                height={400}
                                format="webp"
                                loading="lazy"
                                class="project-image"
                            />
                            <span class="category-tag">
                                {post.data.category}
                            </span>
                        </div>
                        
                        <div class="txt-content">
                            <div class="location-row">
                                <MapPin size={16} />
                                <span>{post.data.location}</span>
                            </div>
                            <h3>{post.data.title}</h3>
                            <div class="card-footer">
                                <span class="view-link">View Project</span>
                                <ArrowRight size={18} />
                            </div>
                        </div>
                    </a>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .home-work-snippet { 
        padding: 5rem 0; 
        background: #fdfdfd; 
    }

    .section-intro { 
        text-align: center;
        margin-bottom: 3.5rem; 
    }

    .section-intro h2 { 
        color: #001f3f; 
        font-size: clamp(2rem, 5vw, 2.5rem);
        font-family: "Montserrat-Bold", sans-serif; 
        margin-bottom: 0.75rem;
    }

    .snippet-grid { 
        display: grid; 
        /* UI FIX: auto-fill keeps cards at a set width even if there are only 2 */
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); 
        gap: 2.5rem; 
        justify-content: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .card-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .mini-card { 
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 400px; /* Limits width when only 1 or 2 cards exist */
        text-decoration: none;
        color: inherit;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .mini-card:hover { 
        transform: translateY(-10px); 
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    }

    .img-container { 
        position: relative; 
        height: 240px;
        overflow: hidden; 
    }

    .project-image { 
        width: 100%; 
        height: 100%; 
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .mini-card:hover .project-image {
        transform: scale(1.08);
    }
    
    .category-tag { 
        position: absolute; 
        top: 1.25rem; 
        right: 1.25rem; 
        background: rgba(255, 255, 255, 0.95);
        color: var(--primary-color); 
        padding: 0.4rem 0.8rem; 
        font-size: 0.7rem; 
        font-weight: 800; 
        font-family: "Montserrat-ExtraBold", sans-serif;
        border-radius: 30px;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .txt-content { 
        padding: 1.75rem; 
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .location-row {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--secondary-color); /* Gold for the Location */
        font-weight: 700;
        font-family: "Montserrat-Bold", sans-serif;
        font-size: 0.9rem;
    }

    .txt-content h3 { 
        font-size: 1.25rem; 
        color: var(--primary-color); 
        line-height: 1.4; 
        font-family: "Montserrat-Bold", sans-serif;
        margin: 0;

        /* THE FIX: Fixed height + Line Clamping */
        height: 4.2em;          /* Approx 2.5 lines of text */
        display: -webkit-box;
        -webkit-line-clamp: 2;  /* Limits to 2 lines */
        -webkit-box-orient: vertical;  
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-footer {
        margin-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--primary-color);
    }

    .view-link { 
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", sans-serif;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    @media (max-width: 480px) {
        .snippet-grid {
            grid-template-columns: 1fr;
        }
        .mini-card {
            max-width: 100%;
        }
    }
</style>