---
import ROIAnalysisChart from "./vue/ROIAnalysisChart.vue";
---

<section id="roi-analysis">
    <div class="roi-container">
        <div class="section-intro">
            <span class="section-subtitle">Data & Insights</span>
            <h2 class="section-title">
                Garage Door Replacement: The #1 ROI Home Improvement Project
            </h2>
            <p>
                According to the 2025 Zonda Cost vs. Value Report, garage door
                replacement delivers a 268% return on investment at resale —
                ranking #1 out of 28 home improvement projects in North America.
            </p>
            <div class="accent-line"></div>
        </div>
        <div class="roi-card">
            <ROIAnalysisChart client:visible />

            <div class="roi-source">
                Source: Cost vs. Value Report (National Averages)
            </div>
        </div>
    </div>
</section>

<style>
    /* ROI Analysis Section */
    #roi-analysis {
        background-color: #001f3f;
        padding-top: 4rem; /* py-16 */
        padding-bottom: 4rem;
        padding-left: 1rem; /* px-4 */
        padding-right: 1rem;
    }

    /* Container */
    .roi-container {
        max-width: 80rem; /* max-w-5xl */
        margin-left: auto;
        margin-right: auto;
    }

    /* Section Header */
    .roi-header {
        margin-bottom: 2.5rem; /* mb-10 */
        text-align: center;
    }
    .section-intro {
        text-align: center;
        margin-bottom: 3.5rem;
    }
    .section-subtitle {
        display: block;
        color: var(--gold);
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 0.5rem;
    }
    .section-title {
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: #ffffff;
        font-weight: 900;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.1;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .section-intro p {
        color: #ffffff; /* text-gray-600 */
        opacity: 0.7;
    }
    .accent-line {
        width: 60px;
        height: 5px;
        background: var(--gold);
        margin-top: 1rem;
        border-radius: 2px;
        margin: 0 auto;
    }

    @media (min-width: 768px) {
        .roi-header {
            text-align: left; /* md:text-left */
        }
    }

    .roi-header h2 {
        font-family: "Montserrat-Bold", "Inter", sans-serif;
        font-size: 1.875rem; /* text-3xl */
        color: #ffffff; /* text-primary */
        margin-bottom: 0.75rem; /* mb-3 */
    }

    /* Card */
    .roi-card {
        background-color: #ffffff; /* bg-white */
        padding: 1.5rem; /* p-6 */
        border-radius: 1rem; /* rounded-xl */
        box-shadow:
            0 10px 15px -3px rgba(0, 0, 0, 0.1),
            0 4px 6px -2px rgba(0, 0, 0, 0.05); /* shadow-lg */
    }

    /* Chart Container */
    .chart-container {
        width: 100%;
        height: 400px; /* Adjust height as needed */
    }

    /* Source text */
    .roi-source {
        margin-top: 1.5rem; /* mt-6 */
        text-align: center;
        font-size: 0.875rem; /* text-sm */
        color: #6b7280; /* text-gray-500 */
        font-style: italic;
    }
</style>
