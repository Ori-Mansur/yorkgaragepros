---
// "Openers we install" comparison, shown on /garage-door-opener/.
// Replaces the 7 old LiftMaster product pages (they now 301 to the hub).
//
// TODO(owner): fill in every "" below in your own words, then set READY = true.
// While READY is false this renders NOTHING in production (placeholders show
// only in `npm run dev`), so half-finished text can't go live.
import OwnerTodo from "./OwnerTodo.astro";

const READY = false;

const intro = ""; // 1–2 sentences: why these are the openers you install.

const openers = [
    {
        name: "6580L", // TODO(owner): full brand + model name as it should appear
        mount: "", // e.g. ceiling / rail mount
        bestFor: "", // which garages/customers you recommend it for
        notes: "", // what you like about it, in your words (noise, Wi-Fi, etc.)
    },
    {
        name: "Skylink side mount", // TODO(owner): exact model name
        mount: "Side (wall) mount",
        bestFor: "",
        notes: "",
    },
];
---

{
    READY ? (
        <section id="openers-we-install" class="openers-compare">
            <h2>Openers we install</h2>
            <p>{intro}</p>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Opener</th>
                            <th scope="col">Mount</th>
                            <th scope="col">Best for</th>
                            <th scope="col">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {openers.map((o) => (
                            <tr>
                                <th scope="row">{o.name}</th>
                                <td>{o.mount}</td>
                                <td>{o.bestFor}</td>
                                <td>{o.notes}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>
    ) : (
        <OwnerTodo>
            "Openers we install" comparison (6580L vs Skylink side mount) goes
            here. Fill in src/components/OpenersWeInstall.astro in your own
            words and set READY = true.
        </OwnerTodo>
    )
}

<style>
    .openers-compare {
        background: white;
        padding: 2rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        margin-bottom: 3rem;
    }
    .openers-compare h2 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #1c2a44;
        margin-bottom: 1rem;
    }
    .openers-compare p {
        line-height: 1.7;
        margin-bottom: 1.5rem;
    }
    .table-wrap {
        overflow-x: auto;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }
    th,
    td {
        text-align: left;
        padding: 0.75rem;
        border-bottom: 1px solid #e2e8f0;
        vertical-align: top;
    }
    thead th {
        color: #1c2a44;
        font-weight: 800;
    }
</style>
