---
// src/components/Schema.astro
// Site-wide business entity. Rendered once per page from Layout.astro.
// Keep this factual: no ratings/reviews markup (Google treats ratings a
// business publishes about itself as "self-serving" and ignores or penalises them).
import logoImg from "../assets/logoonly.png";
import heroImg from "../assets/heropagemobile.webp";

const SITE = "https://yorkgaragepros.com";

// Build-time asset URLs (always match the files emitted by the current build).
const logoUrl = new URL(logoImg.src, SITE).href;
const imageUrl = new URL(heroImg.src, SITE).href;

// TODO(owner): add the Google Business Profile share/CID URL here once confirmed,
// e.g. "https://maps.google.com/?cid=...". Do NOT use the review-request link.
const GBP_PROFILE_URL = "";

const sameAs = [
    GBP_PROFILE_URL,
    "https://www.facebook.com/people/York-Garage-Pros/61584685029221/",
    "https://www.instagram.com/york_garage_pros/",
    "https://homestars.com/profile/york-garage-pros",
].filter(Boolean);

// Towns within ~40 km of Newmarket (same list as /service-areas/).
const areaServed = [
    "Newmarket",
    "Aurora",
    "East Gwillimbury",
    "Georgina",
    "King",
    "Bradford West Gwillimbury",
    "Richmond Hill",
    "Whitchurch-Stouffville",
    "Markham",
    "Vaughan",
    "Innisfil",
    "Uxbridge",
    "North York",
].map((name) => ({ "@type": "City", name }));

const organizationSchema = {
    "@context": "https://schema.org",
    "@id": `${SITE}/#organization`,
    "@type": "HomeAndConstructionBusiness",
    name: "York Garage Pros",
    url: `${SITE}/`,
    logo: logoUrl,
    image: imageUrl,
    telephone: "+1-905-960-9947",
    email: "info@yorkgaragepros.com",
    hasMap: "https://maps.app.goo.gl/XnHLJuW9Y2hTz9GF7",
    sameAs,
    priceRange: "$$",
    // Service-area business: street address intentionally omitted.
    // TODO(owner): if your Google Business Profile publicly shows a street
    // address, add the exact same streetAddress here.
    address: {
        "@type": "PostalAddress",
        addressLocality: "Newmarket",
        addressRegion: "ON",
        postalCode: "L3X 2B1",
        addressCountry: "CA",
    },
    geo: {
        "@type": "GeoCoordinates",
        latitude: 44.0592,
        longitude: -79.4613,
    },
    areaServed,
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday",
            ],
            opens: "00:00",
            closes: "23:59",
        },
    ],
    hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Garage Door Repair & Installation Services",
        itemListElement: [
            "Garage Door Spring Replacement",
            "Garage Door Repair",
            "Garage Door Installation",
            "Garage Door Opener Installation & Repair",
        ].map((name) => ({
            "@type": "Offer",
            itemOffered: { "@type": "Service", name },
        })),
    },
    description:
        "York Garage Pros is a Newmarket-based garage door company offering garage door repair, spring replacement, new door installation and opener installation across York Region and south Simcoe County. Insured.",
};
---

<script
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
/>
