//         description: `Professional ${serviceName} in York Region & Simcoe County by ${businessData.name}.`,
//         provider: {
//             "@id": `${businessData.url}/#organization`,
//         },
//         aggregateRating: {
//             "@type": "AggregateRating",
//             ratingValue: businessData.rating.value,
//             reviewCount: businessData.rating.count,
//         },
//     };
// }
---

<script
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
/>

{
    serviceSchema && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify(serviceSchema)}
        />
    )
}
