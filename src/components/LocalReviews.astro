---
import reviews from "../data/reviews.json";
import { Star, MessageSquarePlus } from "@lucide/astro";

function getTimeAgo(dateString: string) {
    const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
    const postDate = new Date(dateString);
    const now = new Date();
    const diffInTime = postDate.getTime() - now.getTime();
    const diffInDays = Math.round(diffInTime / (1000 * 3600 * 24));

    return diffInDays === 0 ? "Today" : rtf.format(diffInDays, "day");
}

// The direct review invitation link
const reviewLink = "https://g.page/r/CUzO9_99F8FREBM/review";
// The main business profile link
const googleMapsUrl = "https://maps.app.goo.gl/yM4r65m9Y6v7C8G87";
---

<section class="reviews-section">
    <div class="services-container">
        <div class="section-intro">
            <span class="section-subtitle">Local Feedback</span>
            <h2 class="section-title">Testimonials</h2>
            <p>Trusted by Your Neighbors in York & Simcoe</p>
            <div class="accent-line"></div>
        </div>

        <div class="reviews-grid">
            {
                reviews.map((review) => (
                    <a
                        href={review.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="review-card"
                    >
                        <div class="review-header">
                            <div class="stars">
                                {[...Array(review.rating)].map(() => (
                                    <Star
                                        size={14}
                                        fill="#e8a900"
                                        color="#e8a900"
                                    />
                                ))}
                            </div>
                            <time datetime={review.date} class="review-date">
                                {getTimeAgo(review.date)}
                            </time>
                        </div>

                        <p class="review-text">"{review.text}"</p>

                        <div class="reviewer-footer">
                            <div class="reviewer-meta">
                                <span class="reviewer-name">{review.name}</span>
                                <span class="reviewer-loc">
                                    {review.location}
                                </span>
                            </div>
                            <div class="google-badge">
                                <span class="google-logo">G</span>
                                <span>Review</span>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>

        <div class="reviews-actions">
            <div class="cta-content">
                <p>
                    Happy with our service? Join our list of satisfied
                    neighbors.
                </p>
                <div class="btn-group">
                    <a
                        href={reviewLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-primary-gold"
                    >
                        <MessageSquarePlus size={18} />
                        Write a Review
                    </a>
                    <a
                        href={googleMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-secondary"
                    >
                        Read All Google Reviews
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<style>
    .services-container {
        max-width: 1100px;
        margin: 0 auto;
    }
    .section-intro {
        text-align: center;
        margin-bottom: 3.5rem;
    }
    .section-subtitle {
        display: block;
        color: var(--gold);
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 0.5rem;
    }
    .section-title {
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: var(--navy);
        font-weight: 900;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.1;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .accent-line {
        width: 60px;
        height: 5px;
        background: var(--gold);
        margin-top: 1rem;
        border-radius: 2px;
        margin: 0 auto;
    }
    .reviews-section {
        padding: 100px 20px; /* Increased padding for more "breathability" */
        background-color: #ffffff;
    }

    .reviews-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 30px; /* Wider gap for cleaner look */
        align-items: stretch;
    }

    @media (min-width: 768px) {
        .reviews-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .review-card {
        background: #ffffff;
        padding: 35px;
        border-radius: 16px;
        /* Improved shadow for white-on-white visibility */
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        border: 1px solid #f0f0f0;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        text-decoration: none;
        display: flex;
        flex-direction: column;
    }

    .review-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        border-color: var(--gold);
    }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .stars {
        display: flex;
        gap: 3px;
    }

    .review-date {
        font-size: 0.75rem;
        color: #a0a0a0;
        font-weight: 600;
    }

    .review-text {
        font-size: 1rem;
        line-height: 1.7;
        color: #555; /* Slightly softer than pure black */
        margin-bottom: 2rem;
        font-style: italic;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 6;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .reviewer-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-top: 1px solid #f5f5f5;
        padding-top: 1.2rem;
    }

    .reviewer-meta {
        display: flex;
        flex-direction: column;
    }

    .reviewer-name {
        font-weight: 800;
        color: var(--navy);
        font-size: 1.05rem;
    }

    .reviewer-loc {
        font-size: 0.75rem;
        color: var(--gold);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .google-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #fcfcfc;
        padding: 6px 12px;
        border-radius: 30px;
        border: 1px solid #eee;
        font-size: 0.7rem;
        color: #777;
    }

    .google-logo {
        color: #4285f4;
        background: conic-gradient(
            from -45deg,
            #ea4335 110deg,
            #4285f4 90deg 180deg,
            #34a853 180deg 270deg,
            #fbbc05 270deg
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-weight: 900;
    }

    /* CTA box now uses gray to stand out against white bg */
    .reviews-actions {
        margin-top: 5rem;
        padding: 50px;
        background: #f8f9fa;
        border-radius: 24px;
        text-align: center;
        border: 1px solid #eee;
    }

    .cta-content p {
        font-family: "Montserrat-Bold", sans-serif;
        color: var(--navy);
        font-size: 1.2rem;
        margin-bottom: 2rem;
    }

    .btn-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }

    @media (min-width: 640px) {
        .btn-group {
            flex-direction: row;
            justify-content: center;
        }
    }

    .btn-primary-gold {
        background-color: var(--gold);
        color: #fff;
        padding: 16px 32px;
        border-radius: 10px;
        font-weight: 700;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(232, 169, 0, 0.3);
    }

    .btn-primary-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(232, 169, 0, 0.4);
    }

    .link-secondary {
        color: var(--navy);
        font-weight: 800;
        text-decoration: none;
        font-size: 1rem;
        border-bottom: 2px solid var(--gold);
        padding-bottom: 2px;
        transition: color 0.2s;
    }

    .link-secondary:hover {
        color: var(--gold);
    }
</style>
