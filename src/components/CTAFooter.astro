---
import "../styles/global.css";
import { Phone, CalendarCheck } from "@lucide/astro";
const {
    title = "Ready to Start Your Project?",
    desc = "Let's discuss how we can transform your garage space. Free, no-obligation consultations available.",
} = Astro.props;
---

<section class="cta-footer">
    <div class="container center">
        <h2>{title}</h2>
        <p>
            {desc}
        </p>
        <!-- <div class="cta-actions">
            <a class="btn-gold" href="/booking/">Book a Service Now</a>
            <a
                class="btn-white"
                href="tel:+19059609947"
                aria-label="Call York Garage Pros at 905-960-9947"
                >Call Us Today</a
            >
        </div> -->
        <div class="cta-actions">
            <a
                class="btn-gold-call"
                href="tel:+19059609947"
                aria-label="Call Now"
            >
                <Phone size={22} />
                <span class="call-mobile">Call Now</span>
                <span class="call-text-desktop">905-960-9947</span>
            </a>
            <a class="btn-white-quote" href="/booking/">
                <CalendarCheck size={22} />
                <span>Get Quote</span>
            </a>
        </div>
    </div>
</section>
<style>
    :root {
        --navy: #1c2a44;
        --gold: #e8a900;
        --neutral-bg: #f3f4f6;
        --text: #343d46;
        --muted: #6b7280;
        --white: #ffffff;
        --shadow-lg: 0 16px 40px rgba(10, 20, 40, 0.12);
    }
    /* ========== CTA Footer ========== */
    .cta-footer {
        background: var(--neutral-bg);
        color: #555;
        padding: 48px 20px;
        text-align: center;
    }
    .cta-footer h2 {
        color: var(--navy);
        font-family: "Montserrat-Bold", sans-serif;
        font-size: 32px;
        margin-bottom: 12px;
    }
    .cta-footer p {
        margin-top: 0px;
        margin-bottom: 30px;
    }
    .cta-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 16px;
        flex-wrap: wrap;
    }
    .btn-gold {
        background: var(--gold);
        color: var(--navy);
        padding: 12px 20px;
        border-radius: 10px;
        text-decoration: none;
        font-family: "Montserrat-ExtraBold", sans-serif;
    }
    .btn-white {
        background: var(--navy);
        color: #fff;
        padding: 12px 20px;
        border-radius: 10px;
        text-decoration: none;
        font-family: "Montserrat-Bold", sans-serif;
    }
    /* CTA BOXES */
    .cta-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-bottom: 1.5rem;
    }

    .btn-gold-call,
    .btn-white-quote {
        flex: 1;
        min-width: 155px;
        padding: 16px 10px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 1.1rem;
    }

    .btn-gold-call {
        background: #e8a900;
        color: #1c2a44;
        box-shadow: 0 4px 12px rgba(232, 169, 0, 0.3);
    }
    .btn-white-quote {
        background: #1c2a44;
        color: #ffffff;
    }
    .call-text-desktop {
        display: none;
    }
    .call-mobile {
        display: inline;
    }

    @media (min-width: 768px) {
        .call-text-desktop {
            display: inline;
        }
        .call-mobile {
            display: none;
        }

        .btn-gold-call,
        .btn-white-quote {
            max-width: 280px;
            font-size: 1.25rem;
        }
    }
</style>
