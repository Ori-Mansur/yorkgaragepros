---
import "../styles/global.css";
import { SprayCan, Siren, Scale } from "@lucide/astro";
---

<section class="safety-tips">
  <div class="safety-container">
    <h2 class="safety-title">Homeowner Safety & Performance Tips</h2>

    <div class="tips-grid">

      <article class="tip-card tip-emergency">
        <div class="tip-header">
          <span class="tip-icon emg">
            <Siren />
          </span>
          <h3>24/7 Emergency Service</h3>
        </div>
        <p>
          A stuck or off-track door is a major security and safety risk. 
          <strong>We’re on standby today</strong> across the York Region and Simcoe County to ensure 
          your family and vehicles aren't trapped.
        </p>
        <a href="tel:+19059609947" class="mini-cta">Call Now &rarr;</a>
      </article>

  
      <article class="tip-card tip-warning">
        <div class="tip-header">
          <span class="tip-icon balance">
            <Scale />
          </span>
          <h3>The Balance Test</h3>
        </div>
        <p>
          Pull your red cord and lift the door manually. If it drops or feels heavy, 
          your <strong>springs are fatigued</strong>. Don't wait for a snap—balance 
          it today to save your opener's motor.
        </p>
      </article>

     
      <article class="tip-card tip-info">
        <div class="tip-header">
          <span class="tip-icon lube">
            <SprayCan />
          </span>
          <h3>Lubrication Warning</h3>
        </div>
        <p>
          Sticky door? Use <strong>silicone spray</strong>, never grease. Heavy grease 
          attracts Ontario road salt and grit, creating a grinding paste that 
          destroys your bearings and rollers.
        </p>
      </article>
    </div>

    <div class="safety-cta">
      <a href="tel:+19059609947" class="cta-button">
        Need a Safety Inspection? Call Now
      </a>
    </div>
  </div>
</section>

<style>
  /* ===== Section Layout ===== */
  .safety-tips {
    background: #ffffff;
    color: #001f3f; /* Standard Navy */
    padding: 5rem 1rem;
    margin: 2rem 0;
  }

  .safety-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .safety-title {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 3.5rem;
    color: #001f3f;
    font-family: "Montserrat-ExtraBold", sans-serif;
  }

  /* ===== Grid System ===== */
  .tips-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* ===== Card Styling ===== */
  .tip-card {
    background: #001f3f; /* Navy background for cards */
    padding: 2rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .tip-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }

  /* Semantic Borders */
  .tip-emergency { border-top: 5px solid #ef4444; } /* Red */
  .tip-warning   { border-top: 5px solid #f59e0b; } /* Gold */
  .tip-info      { border-top: 5px solid #38bdf8; } /* Blue */

  /* Header & Icons */
  .tip-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .tip-icon svg {
    width: 2.4rem;
    height: 2.4rem;
  }

  /* Icon Colors */
  .emg svg     { color: #ef4444; }
  .balance svg { color: #f59e0b; }
  .lube svg    { color: #38bdf8; }

  .tip-card h3 {
    font-size: 1.3rem;
    color: #ffffff;
    margin: 0;
    font-weight: 700;
    font-family: "Montserrat-Bold", sans-serif;
  }

  /* Typography */
  .tip-card p {
    color: #cbd5e1; /* Light grayish blue for readability */
    line-height: 1.7;
    font-size: 1rem;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .mini-cta {
    color: #ef4444;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9rem;
    text-transform: uppercase;
    font-family: "Montserrat-Bold", sans-serif;
  }

  /* ===== Main CTA ===== */
  .safety-cta {
    text-align: center;
    margin-top: 4rem;
  }

  .cta-button {
    display: inline-block;
    background: #d4af37; /* Gold */
    color: #001f3f;
    font-weight: 800;
    font-family: "Montserrat-ExtraBold", sans-serif;
    padding: 1.1rem 2.5rem;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
  }

  .cta-button:hover {
    background: #c29b2e;
    transform: scale(1.05);
  }

  /* ===== Responsive ===== */
  @media (min-width: 768px) {
    .tips-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>