---
export const prerender = true;
import "../../styles/global.css";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import UtilityNav from "../../components/UtilityNav.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import QuickQuote from "../../components/vue/QuickQuote.vue";
import { capitalizeWords } from "../../utils/helpers";

type ServiceAreaEntry = CollectionEntry<"service-areas">;

export async function getStaticPaths() {
  const servicePages = await getCollection("service-areas");
  const uniqueCities = [...new Set(servicePages.map((page) => page.data.city))];
  return uniqueCities.map((city) => ({
    params: { city },
    props: { city },
  }));
}

const { city } = Astro.props as { city: string };
const cityName = capitalizeWords(city);

// 1. Get the primary content for THIS city from service-areas
const allServiceAreas = await getCollection("service-areas");
const cityContent = allServiceAreas.find((p) => p.data.city === city && p.data.service == 'garage-door-repair');


// 2. Get the catalog links for the sitemap/menu
const catalogLinks = await getCollection("service-catalogs");

// Render the city-specific MDX if it exists
const RenderedContent = cityContent ? await cityContent.render() : null;
const Content = RenderedContent ? RenderedContent.Content : null;

const services: string[] = [
  "Spring Replacement",
  "Opener Repair",
  "Cable Fix & Repair",
  "Emergency Service",
  "Broken Spring Fix",
  "Remote & Sensor Fix",
  "Track Realignment",
  "New Door Estimates",
  "Weather Stripping",
  "Panel Replacement"
];

interface CityPageData {
  title: string;
  description: string;
  h1: string;
  schema: object;
}

function getCityPageData(cityName: string): CityPageData {
  const charSum = cityName.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const serviceIndex = charSum % services.length;
  const rotatedService = services[serviceIndex];

  const title = `${cityName} Garage Door Repair & Install | Same Day ${rotatedService}`;
  const description = `Need a fix? We invite you to experience our local, same-day service in ${cityName}. Specialized in ${rotatedService.toLowerCase()} and professional garage door installation.`;
  const h1 = `Reliable Garage Door Repair and Installation in ${cityName}`;

  // Structured Data for AI Agents
  const schema = {
    "@context": "https://schema.org",
    "@type": "GarageDoorControl",
    "name": `Your Business - ${cityName}`,
    "description": description,
    "areaServed": {
      "@type": "City",
      "name": cityName
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Garage Door Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": rotatedService }
        },
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "Garage Door Installation" }
        },
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "New Garage Door Sales" }
        }
      ]
    }
  };

  return { title, description, h1, schema };
}


// Usage
const citySEO = getCityPageData(cityName);
 
// "Newmarket Garage Door Repair & Install | Same Day Spring Replacement"
---

<Layout title={citySEO.title} description={citySEO.description}>
  <script 
        type="application/ld+json" 
        set:html={JSON.stringify(citySEO.schema)} 
      />
  <UtilityNav />
  <Header />

  <section class="city-hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <div class="hero-badge">📍 Local Service in {cityName}</div>
        <h1 class="page-title">{citySEO.h1}</h1>
        <p class="hero-subtitle">
          Professional, same-day garage door solutions for homeowners in <strong
            >{cityName}</strong
          >. Licensed technicians and upfront pricing guaranteed.
        </p>
        <div class="hero-actions">
          <a href="tel:+19059609947" class="btn-call-main">
            <span class="label">Call 24/7 For Service</span>
            <span class="number">(905) 960-9947</span>
          </a>
        </div>
      </div>

      <div class="hero-form">
        <div class="quote-card">
          <div class="card-header">
            <h3>Quick Quote</h3>
            <span class="status">● Techs Available in {cityName}</span>
          </div>
          <QuickQuote client:load city={cityName} />
        </div>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="container trust-flex">
      <div class="trust-item">⭐ 5-Star Service</div>
      <div class="trust-item">🛡️ Licensed & Insured</div>
      <div class="trust-item">🕒 60-Min Response</div>
      <div class="trust-item">✅ Same-Day Repair</div>
    </div>
  </div>

  <main class="main-content">
    <div class="container">
      
      {
        Content ? (
          <article class="prose-content">
            <Content />
          </article>
        ) : (
          <p>
            Expert garage door repair services available in {cityName}. Call for
            a free estimate.
          </p>
        )
      }
    </div>
  </main>

  <section class="service-menu">
    <div class="container">
      <div class="menu-header">
        <h3>Specific Services in {cityName}</h3>
        <p>Explore detailed information for your specific garage door needs:</p>
      </div>
      <div class="link-grid">
        {
          catalogLinks.map((link) => (
            <a href={`/${link.data.service}/${city}/`} class="menu-link">
              {link.data.cardTitle} in {cityName} <span>→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  :root {
    --navy: #1c2a44;
    --navy-dark: #0f172a;
    --gold: #e8a900;
    --red: #dc2626;
    --white: #ffffff;
    --gray-bg: #f8fafc;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* HERO */
  .city-hero {
    background:
      linear-gradient(rgba(28, 42, 68, 0.94), rgba(28, 42, 68, 0.94)),
      url("../../assets/heropagemobile.webp");
    background-size: cover;
    padding: 80px 0;
    color: white;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .hero-badge {
    background: var(--gold);
    color: var(--navy);
    display: inline-block;
    padding: 6px 16px;
    border-radius: 50px;
    font-weight: 800;
    font-size: 0.85rem;
    margin-bottom: 20px;
  }
  .page-title {
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .hero-subtitle {
    font-size: 1.25rem;
    color: #cbd5e1;
    margin-bottom: 30px;
  }

  .btn-call-main {
    display: inline-flex;
    flex-direction: column;
    background: var(--red);
    color: white;
    padding: 14px 40px;
    border-radius: 12px;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 15px 30px rgba(220, 38, 38, 0.4);
  }
  .btn-call-main .label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .btn-call-main .number {
    font-size: 1.8rem;
    font-weight: 900;
  }

  /* QUOTE CARD */
  .quote-card {
    background: white;
    padding: 32px;
    border-radius: 20px;
    color: var(--navy);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
  .card-header {
    margin-bottom: 24px;
    border-bottom: 1px solid #eee;
    padding-bottom: 16px;
  }
  .card-header h3 {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
  }
  .status {
    font-size: 0.85rem;
    color: #22c55e;
    font-weight: 700;
  }

  /* TRUST BAR */
  .trust-bar {
    background: var(--navy-dark);
    padding: 24px 0;
    border-bottom: 4px solid var(--gold);
  }
  .trust-flex {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 15px;
  }
  .trust-item {
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* CONTENT AREA */
  .main-content {
    padding: 80px 0;
    background: white;
  }
  .prose-content :global(h2) {
    font-size: 2.2rem;
    color: var(--navy);
    margin: 40px 0 20px;
    font-weight: 800;
  }
  .prose-content :global(p) {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #334155;
    margin-bottom: 24px;
  }

  /* SERVICE MENU */
  .service-menu {
    padding: 80px 0;
    background: var(--gray-bg);
    border-top: 1px solid #e2e8f0;
  }
  .menu-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .menu-header h3 {
    font-size: 2rem;
    color: var(--navy);
    font-weight: 800;
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .menu-link {
    background: white;
    padding: 20px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--navy);
    font-weight: 700;
    border: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    transition: all 0.2s;
  }
  .menu-link:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  .menu-link span {
    color: var(--red);
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
</style>
