---
import "../../styles/global.css";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import UtilityNav from "../../components/UtilityNav.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Sidebar from "../../components/Sidebar.astro";
// Using your QuickQuote component
import QuickQuote from "../../components/vue/QuickQuote.vue";

type ServicePageEntry = CollectionEntry<"service-areas">;

export async function getStaticPaths() {
  const servicePages = await getCollection("service-areas");
  return servicePages.map((page: ServicePageEntry) => ({
    params: {
      service: page.data.service,
      city: page.data.city,
    },
    props: { page },
  }));
}

const { page } = Astro.props as { page: ServicePageEntry };
const { Content } = await page.render();
const { title, h1, metaDescription, cityName, serviceName } = page.data;
---

<Layout title={title} description={metaDescription}>
  <UtilityNav />
  <Header />

  <section class="premium-hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="status-indicator">
          <span class="dot"></span> Licensed Techs Available in {cityName}
        </div>
        <h1>{h1}</h1>
        <p class="hero-lead">
          Fast, reliable <strong>{serviceName}</strong> with transparent pricing.
          We offer same-day service and 24/7 emergency support across {
            cityName
          }.
        </p>

        <div class="trust-icons-mobile">
          <span>⭐ 5/5 Rating</span>
          <span>🛡️ Fully Insured</span>
        </div>

        <div class="hero-call-action">
          <a href="tel:+19059609947" class="main-phone-btn">
            <span class="btn-sub">Tap to Call</span>
            <span class="btn-num">(905) 960-9947</span>
          </a>
        </div>
      </div>

      <div class="hero-form-wrapper">
        <div class="quote-box">
          <div class="quote-header">
            <h3>Get a Quick Quote</h3>
            <p>Response time: ~ 15 minutes</p>
          </div>
          <QuickQuote client:load city={cityName} service={serviceName} />
        </div>
      </div>
    </div>
  </section>

  <div class="proof-bar">
    <div class="container proof-flex">
      <div class="proof-item"><strong>Same-Day</strong> Repair</div>
      <div class="proof-item"><strong>Upfront</strong> Pricing</div>
      <div class="proof-item"><strong>No</strong> Hidden Fees</div>
      <div class="proof-item"><strong>24/7</strong> Emergency</div>
    </div>
  </div>

  <section class="main-body">
    <div class="container layout-grid">
      <article class="mdx-render">
        <Content />
      </article>

      <aside class="sidebar">
        <div class="sidebar-card emergency">
          <h4>{cityName} Emergency Service</h4>
          <Sidebar serviceSlug={page.data.service} citySlug={cityName} />
      </aside>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  :root {
    --navy: #1c2a44;
    --gold: #e8a900;
    --red: #dc2626;
    --white: #ffffff;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* HERO DESIGN */
  .premium-hero {
    background: linear-gradient(135deg, #1c2a44 0%, #0f172a 100%);
    padding: 60px 0 100px;
    color: white;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.1);
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 24px;
  }

  .dot {
    height: 8px;
    width: 8px;
    background: #22c55e;
    border-radius: 50%;
    display: inline-block;
    animation: pulse 2s infinite;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 24px;
  }
  .hero-lead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 32px;
    max-width: 600px;
  }

  .main-phone-btn {
    display: inline-flex;
    flex-direction: column;
    background: var(--gold);
    color: var(--navy);
    padding: 14px 40px;
    border-radius: 12px;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 20px 25px -5px rgba(220, 38, 38, 0.4);
    transition: transform 0.2s ease;
  }
  .main-phone-btn:hover {
    transform: translateY(-3px);
  }
  .btn-sub {
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.9;
  }
  .btn-num {
    font-size: 1.8rem;
    font-weight: 900;
  }

  /* QUOTE BOX */
  .quote-box {
    background: white;
    border-radius: 20px;
    padding: 32px;
    color: var(--navy);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
  .quote-header {
    margin-bottom: 24px;
    border-bottom: 1px solid #eee;
    padding-bottom: 16px;
  }
  .quote-header h3 {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
  }
  .quote-header p {
    font-size: 0.9rem;
    color: #22c55e;
    font-weight: 700;
    margin: 4px 0 0;
  }

  /* PROOF BAR */
  .proof-bar {
    background: #f8fafc;
    padding: 24px 0;
    border-bottom: 1px solid #e2e8f0;
  }
  .proof-flex {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 16px;
  }
  .proof-item {
    font-size: 1rem;
    color: var(--navy);
  }

  /* CONTENT LAYOUT */
  .main-body {
    padding: 80px 0;
  }
  .layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 64px;
  }

  .mdx-render :global(h2) {
    font-size: 2.2rem;
    color: var(--navy);
    margin-top: 48px;
    font-weight: 800;
  }
  .mdx-render :global(p) {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #334155;
  }

  .sidebar-card {
    background: #f1f5f9;
    padding: 32px;
    border-radius: 16px;
    margin-bottom: 24px;
  }
  .emergency {
    background: var(--navy);
    color: white;
  }
  .sidebar-tel {
    display: block;
    background: var(--gold);
    color: var(--navy);
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 900;
    text-align: center;
    margin-top: 16px;
  }

  @keyframes pulse {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
    100% {
      opacity: 1;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
    .layout-grid {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
