---
export const prerender = true;
import "../../styles/global.css";
import { Picture } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import UtilityNav from "../../components/UtilityNav.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/SmallFAQ.astro";
import { getDoorTypeImage } from "../../utils/helpers";
import {
    ArrowRight,
    Phone,
    ClipboardList,
    CircleCheck,
    ShieldCheck,
    Clock,
    Star,
} from "@lucide/astro";

// Import the configuration with proper typing
import serviceConfigData from "../../data/service-page-config.json";
import type { ServicePageConfigCollection } from "../../types/service-page-config.types";

const serviceConfig = serviceConfigData as ServicePageConfigCollection;

export async function getStaticPaths() {
    const serviceAreas = await getCollection("service-areas");
    const serviceCatalogs = await getCollection("service-catalogs");

    const uniqueServices = new Set([
        ...serviceAreas.map((page) => page.data.service),
        ...serviceCatalogs.map((entry) => entry.data.service),
    ]);

    return Array.from(uniqueServices).map((service) => ({
        params: { service },
        props: { service },
    }));
}

const { service } = Astro.props as { service: string };

// Get configuration for this service with proper typing
const config = serviceConfig[service as keyof ServicePageConfigCollection];

if (!config) {
    throw new Error(`No configuration found for service: ${service}`);
}

const relatedAreas = (await getCollection("service-areas")).filter(
    (page) => page.data.service === service,
);

const relatedCatalogs = (await getCollection("service-catalogs"))
    .filter((entry) => entry.data.service == service)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));

const title = `${config.serviceName} | York Garage Pros | Upfront Pricing`;
const metaDescription = config.seo.metaDescription;
---

<Layout title={title} description={metaDescription}>
    <UtilityNav />
    <Header />

    <main class="hub-page">
        <!-- Hero Section -->
        <header class="hub-hero">
            <div class="container">
                <div class="hero-content">
                    <h1 class="hero-title">{config.hero.title}</h1>
                    <p class="hero-subtitle">{config.hero.subtitle}</p>
                    <div class="trust-bar">
                        {
                            config.hero.trustBadges.map((badge) => (
                                <div class="trust-item">
                                    <CircleCheck size={18} class="text-gold" />
                                    <span>{badge}</span>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </header>

        <div class="container content-wrapper">
            <div class="hub-layout">
                <section class="main-content">
                    <!-- Intro Content -->
                    <section class="intro-content">
                        <div class="intro-text">
                            {
                                config.introContent.paragraphs.map(
                                    (paragraph) => <p set:html={paragraph} />,
                                )
                            }
                        </div>
                    </section>

                    <!-- Emergency Banner (conditional) -->
                    {
                        config.emergencyBanner.show && (
                            <div class="emergency-banner">
                                <div class="emergency-content">
                                    <h3>🚨 {config.emergencyBanner.title}</h3>
                                    <p>{config.emergencyBanner.text}</p>
                                    <a
                                        href={`tel:${config.emergencyBanner.ctaPhone}`}
                                        class="emergency-btn"
                                    >
                                        <Phone size={18} />
                                        {config.emergencyBanner.ctaText}
                                    </a>
                                </div>
                            </div>
                        )
                    }

                    <!-- Signs List (conditional) -->
                    {
                        config.signsList.show && config.signsList.items && config.signsList.items.length > 0 && (
                            <section class="signs-section">
                                <h2 class="signs-title">
                                    {config.signsList.title}
                                </h2>
                                <ul class="signs-list">
                                    {config.signsList.items.map((item) => (
                                        <li>
                                            <CircleCheck
                                                size={16}
                                                class="text-gold"
                                            />
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        )
                    }

                    <!-- Product Grid -->
                    <div class="section-header-block">
                        <span class="section-subtitle">Local Experts</span>
                        <h2 class="section-title">{config.sectionTitle}</h2>
                        <div class="accent-line"></div>
                    </div>

                    <div class="product-grid">
                        {
                            relatedCatalogs.map((entry) => (
                                <a
                                    href={`/${service}/${entry.data.type}/`}
                                    class="product-card"
                                >
                                    <div class="card-image-box">
                                        <Picture
                                            src={getDoorTypeImage(
                                                entry.data.type,
                                            )}
                                            alt={entry.data.title}
                                            class="card-img"
                                        />
                                        <div class="price-tag">Local Quote</div>
                                    </div>
                                    <div class="card-info">
                                        <h3 class="card-name">
                                            {entry.data.cardTitle ||
                                                entry.data.title}
                                        </h3>
                                        <p class="card-text">
                                            {entry.data.metaDescription ||
                                                `Specialized ${config.serviceName} solutions for your home.`}
                                        </p>
                                        <div class="card-footer">
                                            <span class="view-btn">
                                                View Details
                                            </span>
                                            <ArrowRight size={14} />
                                        </div>
                                    </div>
                                </a>
                            ))
                        }
                    </div>

                    <!-- FAQ and Service Areas -->
                    <div class="local-seo-section">
                        {
                            config.faq.show && config.faq.questions && config.faq.questions.length > 0 && (
                                <FAQ
                                    page={service}
                                    faqs={config.faq.questions}
                                />
                            )
                        }

                        <h2 class="small-title">
                            Serving York Region & Simcoe County
                        </h2>
                        <div class="area-tags">
                            {
                                relatedAreas.map((page) => (
                                    <a
                                        href={`/${page.data.service}/${page.data.city}/`}
                                        class="area-tag"
                                    >
                                        {page.data.cityName}
                                    </a>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <!-- Sidebar -->
                <aside class="sidebar-column">
                    <div class="sticky-container">
                        <div class="cta-box">
                            <div class="cta-top">
                                <span class="badge-gold">
                                    {config.sidebar.badge}
                                </span>
                                <h3>{config.sidebar.title}</h3>
                            </div>
                            <p>{config.sidebar.description}</p>

                            <div class="action-stack">
                                <a href="tel:+19059609947" class="btn-call">
                                    <Phone size={20} />
                                    {config.sidebar.ctaPhone}
                                </a>
                                <a href="/booking/" class="btn-book">
                                    <ClipboardList size={20} />
                                    {config.sidebar.ctaBook}
                                </a>
                            </div>

                            <ul class="benefit-list">
                                {
                                    config.sidebar.benefits.map((benefit) => (
                                        <li>
                                            <CircleCheck
                                                size={16}
                                                class="text-gold"
                                            />
                                            {benefit}
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <div class="review-mini-card">
                            <div class="stars">
                                <Star size={14} fill="currentColor" />
                                <Star size={14} fill="currentColor" />
                                <Star size={14} fill="currentColor" />
                                <Star size={14} fill="currentColor" />
                                <Star size={14} fill="currentColor" />
                            </div>
                            <p>"{config.sidebar.testimonial.text}"</p>
                            <span class="reviewer">
                                - {config.sidebar.testimonial.author}
                            </span>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    /* Your existing CSS remains the same, just adding new styles for intro, emergency, and signs sections */
    :root {
        --navy: #1c2a44;
        --navy-light: #2d3e5d;
        --gold: #e8a900;
        --gold-bright: #ffc433;
        --text-main: #374151;
        --bg-alt: #f8fafc;
        --white: #ffffff;
    }

    .hub-page {
        background: var(--bg-alt);
        color: var(--text-main);
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .hub-hero {
        background: linear-gradient(
            135deg,
            var(--navy) 0%,
            var(--navy-light) 100%
        );
        color: white;
        padding: 4rem 0 4.5rem;
    }
    .hero-content {
        max-width: 850px;
    }
    .hero-title {
        font-size: clamp(2.2rem, 6vw, 3.5rem);
        font-weight: 900;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        letter-spacing: -1px;
    }
    .hero-subtitle {
        font-size: 1.25rem;
        opacity: 0.95;
        margin-bottom: 2rem;
        line-height: 1.5;
        font-weight: 400;
    }

    .trust-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }
    .trust-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: "Montserrat-SemiBold", "Inter", sans-serif;
    }
    .text-gold {
        color: var(--gold);
    }

    .content-wrapper {
        padding-top: 3.5rem;
        padding-bottom: 5rem;
    }
    .hub-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 1024px) {
        .hub-layout {
            grid-template-columns: 1fr 360px;
        }
    }

    /* NEW: Intro Content Styles */
    .intro-content {
        background: white;
        padding: 2.5rem;
        border-radius: 12px;
        margin-bottom: 3rem;
        border: 1px solid #e2e8f0;
    }
    .intro-text p {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--text-main);
        margin-bottom: 1rem;
    }
    .intro-text p:last-child {
        margin-bottom: 0;
    }
    .intro-text a {
        color: var(--gold);
        font-weight: 700;
        text-decoration: none;
    }

    /* NEW: Emergency Banner Styles */
    .emergency-banner {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 3rem;
        box-shadow: 0 10px 20px rgba(220, 38, 38, 0.2);
    }
    .emergency-content h3 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
    }
    .emergency-content p {
        margin-bottom: 1.5rem;
        line-height: 1.6;
        opacity: 0.95;
    }
    .emergency-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: white;
        color: #dc2626;
        padding: 1rem 2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        transition: transform 0.2s;
    }
    .emergency-btn:hover {
        transform: scale(1.05);
    }

    /* NEW: Signs List Styles */
    .signs-section {
        background: #fffdf5;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 3rem;
        border-left: 4px solid var(--gold);
    }
    .signs-title {
        font-size: 1.4rem;
        color: var(--navy);
        font-weight: 800;
        margin-bottom: 1.5rem;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
    }
    .signs-list {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 0.75rem;
    }
    .signs-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
        color: var(--text-main);
    }

    .section-header-block {
        margin-bottom: 2.5rem;
        margin-top: 2rem;
    }
    .section-subtitle {
        display: block;
        color: var(--gold);
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 0.5rem;
    }
    .section-title {
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: var(--navy);
        font-weight: 900;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.1;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .accent-line {
        width: 60px;
        height: 5px;
        background: var(--gold);
        margin-top: 1rem;
        border-radius: 2px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    @media (min-width: 640px) {
        .product-grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
    }

    .product-card {
        background: var(--white);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        transition: all 0.2s ease;
    }
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 20px rgba(0, 0, 0, 0.08);
        border-color: var(--gold);
    }

    .card-image-box {
        position: relative;
        aspect-ratio: 1/1;
        overflow: hidden;
    }
    .card-img {
        width: 100%;
        height: 100%;
    }
    .price-tag {
        position: absolute;
        top: 8px;
        left: 8px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 700;
        font-family: "Montserrat-Bold", "Inter", sans-serif;
    }

    .card-info {
        padding: 1rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }
    .card-name {
        font-size: 1rem;
        color: var(--navy);
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }
    .card-text {
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.4;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .card-footer {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--gold);
        font-weight: 700;
        font-family: "Montserrat-Bold", "Inter", sans-serif;
        font-size: 0.8rem;
    }

    .sticky-container {
        position: sticky;
        top: 2rem;
    }
    .cta-box {
        background: var(--navy);
        color: white;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }
    .badge-gold {
        background: var(--gold);
        color: var(--navy);
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        text-transform: uppercase;
    }
    .cta-box h3 {
        font-size: 1.6rem;
        margin: 0.75rem 0;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.2;
    }
    .cta-box p {
        opacity: 0.85;
        margin-bottom: 2rem;
        font-size: 1rem;
        line-height: 1.5;
    }

    .action-stack {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .btn-call {
        background: var(--gold);
        color: var(--navy);
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 1.1rem;
    }
    .btn-book {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        font-weight: 600;
        font-family: "Montserrat-SemiBold", "Inter", sans-serif;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .benefit-list {
        list-style: none;
        padding: 0;
        margin-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 1.5rem;
    }
    .benefit-list li {
        margin-bottom: 10px;
        font-size: 0.9rem;
        font-weight: 500;
        font-family: "Montserrat", "Inter", sans-serif;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .review-mini-card {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        margin-top: 1.5rem;
        border: 1px solid #e2e8f0;
    }
    .stars {
        color: var(--gold);
        margin-bottom: 0.5rem;
        display: flex;
        gap: 2px;
    }
    .review-mini-card p {
        font-style: italic;
        font-size: 0.9rem;
        color: #475569;
        margin-bottom: 0.5rem;
        line-height: 1.4;
    }
    .reviewer {
        font-weight: 700;
        font-family: "Montserrat-Bold", "Inter", sans-serif;
        font-size: 0.8rem;
        color: var(--navy);
    }

    .local-seo-section {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #e2e8f0;
    }
    .small-title {
        font-size: 1rem;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        color: var(--navy);
        margin-bottom: 1rem;
        text-transform: uppercase;
    }
    .area-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .area-tag {
        background: white;
        border: 1px solid #e2e8f0;
        padding: 6px 14px;
        border-radius: 50px;
        text-decoration: none;
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 500;
        font-family: "Montserrat", "Inter", sans-serif;
        transition: 0.2s;
    }
    .area-tag:hover {
        border-color: var(--gold);
        color: var(--navy);
        background: #fffdf5;
    }

    @media (max-width: 768px) {
        .intro-content {
            padding: 1.5rem;
        }
        .intro-text p {
            font-size: 0.95rem;
        }
        .signs-list {
            grid-template-columns: 1fr;
        }
        .emergency-banner {
            padding: 1.5rem;
        }
        .emergency-content h3 {
            font-size: 1.2rem;
        }
    }

    @media (max-width: 640px) {
        .section-header-block {
            text-align: center;
        }
        .accent-line {
            margin: 1rem auto 0;
        }
        .hero-title {
            text-align: center;
        }
        .hero-subtitle {
            text-align: center;
        }
        .trust-bar {
            justify-content: center;
        }
    }
</style>
