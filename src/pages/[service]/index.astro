---
import "../../styles/global.css";
import { Picture } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import UtilityNav from "../../components/UtilityNav.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCityLogo, getDoorTypeImage } from "../../utils/helpers";
import {
    ArrowRight,
    Phone,
    ClipboardList,
    CircleCheck,
    ShieldCheck,
    Clock,
    Star,
} from "@lucide/astro";

export async function getStaticPaths() {
    const serviceAreas = await getCollection("service-areas");
    const serviceCatalogs = await getCollection("service-catalogs");

    const uniqueServices = new Set([
        ...serviceAreas.map((page) => page.data.service),
        ...serviceCatalogs.map((entry) => entry.data.service),
    ]);

    return Array.from(uniqueServices).map((service) => ({
        params: { service },
        props: { service },
    }));
}

const { service } = Astro.props as { service: string };

const relatedAreas = (await getCollection("service-areas")).filter(
    (page) => page.data.service === service,
);

const relatedCatalogs = (await getCollection("service-catalogs"))
    .filter((entry) => entry.data.service == service)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));

const isRepair = service === "garage-door-repair";
const serviceName =
    relatedAreas[0]?.data.serviceName || service.replace(/-/g, " ");

const title = `${serviceName} | York Garage Pros | Upfront Pricing`;
const metaDescription = `Professional ${serviceName} in York Region & Simcoe County. Locally owned with upfront pricing. Same-day service in ${relatedAreas
    .slice(0, 3)
    .map((p) => p.data.cityName)
    .join(", ")}.`;
---

<Layout title={title} description={metaDescription}>
    <UtilityNav />
    <Header />

    <main class="hub-page">
        <header class="hub-hero">
            <div class="container">
                <div class="hero-content">
                    <h1 class="hero-title">
                        {
                            isRepair
                                ? "Garage Door Won't Open or Close?"
                                : `Local ${serviceName}`
                        }
                    </h1>
                    <p class="hero-subtitle">
                        {
                            isRepair
                                ? "Broken spring or door off-track? Get a fast quote for same-day repairs with honest, upfront pricing across York Region and Simcoe County."
                                : "Upgrade your home with premium garage doors and openers. Professional installation by your local owner-operated experts."
                        }
                    </p>
                    <div class="trust-bar">
                        <div class="trust-item">
                            <CircleCheck size={18} class="text-gold" />
                            <span>Locally Owned & Operated</span>
                        </div>
                        <div class="trust-item">
                            <ShieldCheck size={18} class="text-gold" />
                            <span>Upfront Pricing</span>
                        </div>
                        <div class="trust-item">
                            <Clock size={18} class="text-gold" />
                            <span>Same-Day Service</span>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="container content-wrapper">
            <div class="hub-layout">
                <section class="main-content">
                    <div class="section-header-block">
                        <span class="section-subtitle"
                            >Local Experts</span
                        >
                        <h2 class="section-title">
                            Select Your {isRepair ? "Repair Type" : "Style"}
                        </h2>
                        <div class="accent-line"></div>
                    </div>

                    <div class="product-grid">
                        {
                            relatedCatalogs.map((entry) => (
                                <a
                                    href={`/${service}/${entry.data.type}`}
                                    class="product-card"
                                >
                                    <div class="card-image-box">
                                        <Picture
                                            src={getDoorTypeImage(
                                                entry.data.type,
                                            )}
                                            alt={entry.data.title}
                                            class="card-img"
                                        />
                                        <div class="price-tag">Local Quote</div>
                                    </div>
                                    <div class="card-info">
                                        <h3 class="card-name">
                                            {entry.data.cardTitle ||
                                                entry.data.title}
                                        </h3>
                                        <p class="card-text">
                                            {entry.data.metaDescription ||
                                                `Specialized ${serviceName} solutions for your home.`}
                                        </p>
                                        <div class="card-footer">
                                            <span class="view-btn">
                                                View Details
                                            </span>
                                            <ArrowRight size={14} />
                                        </div>
                                    </div>
                                </a>
                            ))
                        }
                    </div>

                    <div class="local-seo-section">
                        <h2 class="small-title">
                            Serving York Region & Simcoe County
                        </h2>
                        <div class="area-tags">
                            {
                                relatedAreas.map((page) => (
                                    <a
                                        href={`/${page.data.service}/${page.data.city}`}
                                        class="area-tag"
                                    >
                                        {page.data.cityName}
                                    </a>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <aside class="sidebar-column">
                    <div class="sticky-container">
                        <div class="cta-box">
                            <div class="cta-top">
                                <span class="badge-gold"
                                    >York & Simcoe Pros</span
                                >
                                <h3>
                                    {
                                        isRepair
                                            ? "Get a Guaranteed Quote"
                                            : "Get a Free Estimate"
                                    }
                                </h3>
                            </div>
                            <p>
                                {
                                    isRepair
                                        ? "Know your issue? Get a firm price. Not sure why it's stuck? We'll identify the cause and give you a fixed quote before any work begins."
                                        : "Looking for an upgrade? Tell us what you're looking for and we'll provide a transparent, all-inclusive quote for your new installation."
                                }
                            </p>

                            <div class="action-stack">
                                <a href="tel:+19059609947" class="btn-call">
                                    <Phone size={20} /> (905) 960-9947
                                </a>
                                <a href="/booking" class="btn-book">
                                    <ClipboardList size={20} />
                                    {
                                        isRepair
                                            ? "Get Quick Quote"
                                            : "Request Pricing"
                                    }
                                </a>
                            </div>

                            <ul class="benefit-list">
                                {
                                    isRepair ? (
                                        <>
                                            <li>
                                                <CircleCheck
                                                    size={16}
                                                    class="text-gold"
                                                />{" "}
                                                No Surprise Hidden Fees
                                            </li>
                                            <li>
                                                <CircleCheck
                                                    size={16}
                                                    class="text-gold"
                                                />{" "}
                                                5-Star Local Reputation
                                            </li>
                                            <li>
                                                <CircleCheck
                                                    size={16}
                                                    class="text-gold"
                                                />{" "}
                                                Real Licensed Technicians
                                            </li>
                                        </>
                                    ) : (
                                        <>
                                            <li>
                                                <CircleCheck
                                                    size={16}
                                                    class="text-gold"
                                                />{" "}
                                                All-Inclusive Pricing
                                            </li>
                                            <li>
                                                <CircleCheck
                                                    size={16}
                                                    class="text-gold"
                                                />{" "}
                                                Professional Installation
                                            </li>
                                            <li>
                                                <CircleCheck
                                                    size={16}
                                                    class="text-gold"
                                                />{" "}
                                                Local Warranty Support
                                            </li>
                                        </>
                                    )
                                }
                            </ul>
                        </div>

                        <div class="review-mini-card">
                            <div class="stars">
                                <Star size={14} fill="currentColor" />
                                <Star size={14} fill="currentColor" />
                                <Star size={14} fill="currentColor" />
                                <Star size={14} fill="currentColor" />
                                <Star size={14} fill="currentColor" />
                            </div>
                            <p>
                                {
                                    isRepair
                                        ? '"Got a quote within 10 minutes by sending a photo. They fixed my off-track door same-day."'
                                        : '"The price they quoted was exactly what I paid. The new door looks amazing and is so quiet."'
                                }
                            </p>
                            <span class="reviewer"
                                >{
                                    isRepair
                                        ? "- Dave, Newmarket"
                                        : "- Sarah, Aurora"
                                }</span
                            >
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    /* CSS remains identical to the previous version but ensures high contrast for headlines */
    :root {
        --navy: #1c2a44;
        --navy-light: #2d3e5d;
        --gold: #e8a900;
        --gold-bright: #ffc433;
        --text-main: #374151;
        --bg-alt: #f8fafc;
        --white: #ffffff;
    }

    .hub-page {
        background: var(--bg-alt);
        color: var(--text-main);
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .hub-hero {
        background: linear-gradient(
            135deg,
            var(--navy) 0%,
            var(--navy-light) 100%
        );
        color: white;
        padding: 4rem 0 4.5rem;
    }
    .hero-content {
        max-width: 850px;
    }
    .hero-title {
        font-size: clamp(2.2rem, 6vw, 3.5rem);
        font-weight: 900;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        letter-spacing: -1px;
    }
    .hero-subtitle {
        font-size: 1.25rem;
        opacity: 0.95;
        margin-bottom: 2rem;
        line-height: 1.5;
        font-weight: 400;
    }

    .trust-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }
    .trust-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: "Montserrat-SemiBold", "Inter", sans-serif;
    }
    .text-gold {
        color: var(--gold);
    }

    .content-wrapper {
        padding-top: 3.5rem;
        padding-bottom: 5rem;
    }
    .hub-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 1024px) {
        .hub-layout {
            grid-template-columns: 1fr 360px;
        }
    }

    .section-header-block {
        margin-bottom: 2.5rem;
    }
    .section-subtitle {
        display: block;
        color: var(--gold);
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 0.5rem;
    }
    .section-title {
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: var(--navy);
        font-weight: 900;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.1;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .accent-line {
        width: 60px;
        height: 5px;
        background: var(--gold);
        margin-top: 1rem;
        border-radius: 2px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    @media (min-width: 640px) {
        .product-grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
    }

    .product-card {
        background: var(--white);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        transition: all 0.2s ease;
    }
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 20px rgba(0, 0, 0, 0.08);
        border-color: var(--gold);
    }

    .card-image-box {
        position: relative;
        aspect-ratio: 1/1;
        overflow: hidden;
    }
    .card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .price-tag {
        position: absolute;
        top: 8px;
        left: 8px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 700;
        font-family: "Montserrat-Bold", "Inter", sans-serif;
    }

    .card-info {
        padding: 1rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }
    .card-name {
        font-size: 1rem;
        color: var(--navy);
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }
    .card-text {
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.4;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .card-footer {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--gold);
        font-weight: 700;
        font-family: "Montserrat-Bold", "Inter", sans-serif;
        font-size: 0.8rem;
    }

    .sticky-container {
        position: sticky;
        top: 2rem;
    }
    .cta-box {
        background: var(--navy);
        color: white;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }
    .badge-gold {
        background: var(--gold);
        color: var(--navy);
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        text-transform: uppercase;
    }
    .cta-box h3 {
        font-size: 1.6rem;
        margin: 0.75rem 0;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        line-height: 1.2;
    }
    .cta-box p {
        opacity: 0.85;
        margin-bottom: 2rem;
        font-size: 1rem;
        line-height: 1.5;
    }

    .action-stack {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .btn-call {
        background: var(--gold);
        color: var(--navy);
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 1.1rem;
    }
    .btn-book {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        font-weight: 600;
        font-family: "Montserrat-SemiBold", "Inter", sans-serif;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .benefit-list {
        list-style: none;
        padding: 0;
        margin-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 1.5rem;
    }
    .benefit-list li {
        margin-bottom: 10px;
        font-size: 0.9rem;
        font-weight: 500;
        font-family: "Montserrat", "Inter", sans-serif;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .review-mini-card {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        margin-top: 1.5rem;
        border: 1px solid #e2e8f0;
    }
    .stars {
        color: var(--gold);
        margin-bottom: 0.5rem;
        display: flex;
        gap: 2px;
    }
    .review-mini-card p {
        font-style: italic;
        font-size: 0.9rem;
        color: #475569;
        margin-bottom: 0.5rem;
        line-height: 1.4;
    }
    .reviewer {
        font-weight: 700;
        font-family: "Montserrat-Bold", "Inter", sans-serif;
        font-size: 0.8rem;
        color: var(--navy);
    }

    .local-seo-section {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #e2e8f0;
    }
    .small-title {
        font-size: 1rem;
        font-weight: 800;
        font-family: "Montserrat-ExtraBold", "Inter", sans-serif;
        color: var(--navy);
        margin-bottom: 1rem;
        text-transform: uppercase;
    }
    .area-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .area-tag {
        background: white;
        border: 1px solid #e2e8f0;
        padding: 6px 14px;
        border-radius: 50px;
        text-decoration: none;
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 500;
        font-family: "Montserrat", "Inter", sans-serif;
        transition: 0.2s;
    }
    .area-tag:hover {
        border-color: var(--gold);
        color: var(--navy);
        background: #fffdf5;
    }

    @media (max-width: 640px) {
        .section-header-block {
            text-align: center;
        }
        .accent-line {
            margin: 1rem auto 0;
        }
        .hero-title {
            text-align: center;
        }
        .hero-subtitle {
            text-align: center;
        }
        .trust-bar {
            justify-content: center;
        }
    }
</style>
