---
import "../styles/global.css";
// import ClaudeHero from "../components/ClaudeHero.astro";
import Hero0401 from "../components/Hero0401.astro";
import ROIAnalysis from "../components/ROIAnalysis.astro";
import RecentWorkSnippet from "../components/RecentWorkSnippet.astro";
// import Estimator from "../components/Estimator.astro";
import Estimator from "../components/vue/Estimator.vue";
import ServiceCards from "../components/ServiceCards.astro";
import Layout from "../layouts/Layout.astro";
import SubLayout from "../layouts/SubLayout.astro";
// import Banner from "../components/Banner.astro";
import Reviews from "../components/Reviews.astro";
import LocalReviews from "../components/LocalReviews.astro";
import GarageSafety from "../components/GarageSafety.astro";
import FAQ from "../components/FAQ.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
const garageFaqs = [
  {
    question: "My garage door won't open. What should I do first?",
    answer: `Check that the opener has power and that the wall control isn't locked. If the motor runs but the door doesn't move, this is often a broken spring or snapped cable. Do not attempt to lift the door manually; call a technician for a safe diagnosis.`
  },
  {
    question: "How much does a typical garage door repair cost in York Region or Simcoe County?",
    answer: `Minor repairs such as sensor adjustments or lubrication are usually inexpensive. Major repairs like spring replacement or opener repair commonly range from about $250 to $600, depending on parts and labor.`
  },
  {
    question: "Is emergency garage door service available?",
    answer: `Emergency or same-day service may be offered by some local providers; availability depends on scheduling and location. If a door is stuck open or creating a safety issue, contact a local technician promptly.`
  },
  {
    question: "Which type of garage door performs best in Ontario's climate?",
    answer: `Insulated steel doors with a foam core provide good thermal performance and dimensional stability in cold, wet, or humid conditions common in Ontario. Consider R-value and material durability when choosing.`
  },
  {
    question: "Is it safe to repair a garage door spring myself?",
    answer: `No. Torsion springs are under high tension and can cause serious injury if handled incorrectly. Have a qualified technician perform spring replacement. `
  }
];
---

<Layout>
	<SubLayout>
		<!-- <Banner /> -->
		<!-- <ClaudeHero/> -->
		<Hero0401 />
		<ServiceCards />
    <!-- <Reviews/> -->
		<LocalReviews />
		<RecentWorkSnippet />
		<ROIAnalysis />
		<GarageSafety />

		<Estimator client:load id="estimator"/>
		<FAQ faqs={garageFaqs}/>
	</SubLayout>
</Layout>
