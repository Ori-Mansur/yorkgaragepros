---
import Call from "../components/Call.astro";
export interface Props {
	title?: string;
	description?: string;
	serviceName?: string;
	url?: string;
	image?: string;
	noIndex?: boolean;
	hasFirebase?: boolean;
	scripts?: string[];
}
const business = {
	name: "York Garage Pros",
	domain: "https://yorkgaragepros.com",
	logo: "https://yorkgaragepros.com/android-chrome-512x512.png",
	defaultImage:
		"https://yorkgaragepros.com/_astro/heropagemobile.pCMy9GB0_Z2adhm.avif",
};

const {
	title = "York Garage Pros | Garage Door Repair & Installation",
	description = "Professional garage door repair, installation, and maintenance serving York Region & Simcoe County, Ontario and surrounding areas. Fast, local service.",
	url = business.domain,
	image = business.defaultImage,
	noIndex = false,
	hasFirebase = false,
	serviceName,
} = Astro.props;

const companyRating = {
	"@type": "AggregateRating",
	ratingValue: "5.0",
	reviewCount: "5",
	bestRating: "5",
};
function getschema() {
	return {
		"@context": "https://schema.org",
		"@type": "Service",
		"name": serviceName,
		"description": `Professional ${serviceName} in York Region & Simcoe County by York Garage Pros.`,
		"provider": {
			"@id": "https://yorkgaragepros.com/#organization",
		},
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": "5.0",
			"reviewCount": "5",
		},
	};

}
---

