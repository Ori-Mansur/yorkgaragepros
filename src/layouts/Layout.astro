---
import Schema from "../components/Schema.astro";
import Call from "../components/Call.astro";
export interface Props {
	title?: string;
	description?: string;
	serviceName?: string;
	url?: string;
	image?: string;
	noIndex?: boolean;
	hasFirebase?: boolean;
	scripts?: string[];
}
const business = {
	name: "York Garage Pros",
	domain: "https://yorkgaragepros.com",
	logo: "https://yorkgaragepros.com/android-chrome-512x512.png",
	defaultImage:
		"https://yorkgaragepros.com/_astro/heropagemobile.pCMy9GB0_Z2adhm.avif",
};

const {
	title = "York Garage Pros | Garage Door Repair & Installation",
	description = "Professional garage door repair, installation, and maintenance serving York Region & Simcoe County, Ontario and surrounding areas. Fast, local service.",
	url = business.domain,
	image = business.defaultImage,
	noIndex = false,
	hasFirebase = false,
	serviceName,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- Mobile -->
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="dns-prefetch" href="https://maps.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- <link rel="preconnect" href="https://fonts.googleapis.com" /> -->

		<!-- Fonts -->
		<link
			rel="preload"
			href="/fonts/static/Montserrat-Regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/static/Montserrat-ExtraBold.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/static/Montserrat-SemiBold.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/static/Montserrat-Bold.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<!-- ✅ ADD THIS right after viewport meta -->
		<!-- <link
			rel="preload"
			as="image"
			href="/src/assets/heropagemobile.webp"
			type="image/webp"
			fetchpriority="high"
		/> -->
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			noIndex && (
				// If noIndex is true, inject the meta tag
				<meta name="robots" content="noindex, follow" />
			)
		}
		<style is:inline>
			h1 {
				visibility: visible !important;
				opacity: 1 !important;
				display: block !important;
			}
			.skip-link {
				position: absolute;
				top: -100px;
				left: 0;
				background: var(--gold);
				color: var(--navy);
				padding: 8px;
				z-index: 1000;
				transition: top 0.3s;
			}
			.skip-link:focus {
				top: 0;
			}
		</style>

		<!-- Sitemap -->
		<link rel="sitemap" href="/sitemap-0.xml" />
		<!-- Canonical -->
		<link
			rel="canonical"
			href={`https://yorkgaragepros.com${Astro.url.pathname}`}
		/>

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:type" content="website" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<link
			rel="icon"
			type="image/png"
			href="/favicon-96x96.png"
			sizes="96x96"
		/>

		<link rel="icon" href="/favicon.ico" sizes="any" />

		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta name="apple-mobile-web-app-title" content="York Garage Pros" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Local Business Schema -->
		<Schema serviceName={serviceName} />
		<meta name='impact-site-verification' value='f9951a18-b571-49fa-af6d-ad9fbb21147a'>
	</head>

	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Call />
		<main id="main-content">
			<slot />
		</main>

	</body><style></style>
</html>
